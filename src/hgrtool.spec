# PyInstaller spec for HGRTool Desktop.
#   HGRTOOL_LANG=en|ko pyinstaller src/hgrtool.spec --distpath dist --workpath work/pyi/<lang>
# One executable per language: dist/hgrtool.exe (en) and dist/hgrtool-ko.exe (ko).
# Set HGRTOOL_ONEDIR=1 for a folder build (faster start) instead of a single file.
import os
import sys
from pathlib import Path

SRC = Path(SPECPATH)                       # .../src
ONEDIR = os.environ.get("HGRTOOL_ONEDIR") == "1"
ICON = SRC / "res" / ("icon.icns" if sys.platform == "darwin" else "icon.ico")
LANG = os.environ.get("HGRTOOL_LANG", "en")
NAME = "hgrtool" if LANG == "en" else f"hgrtool-{LANG}"
WEB = SRC / "web" / LANG                   # generated by tools/patch_web.py --lang <lang>

a = Analysis(
    [str(SRC / "run_hgrtool.py")],
    pathex=[str(SRC)],
    datas=[(str(WEB), "web")],
    hiddenimports=[],
    excludes=["tkinter", "unittest", "pydoc", "test", "pytest"],
    noarchive=False,
)
pyz = PYZ(a.pure)

if ONEDIR:
    exe = EXE(pyz, a.scripts, [], exclude_binaries=True, name=NAME, console=False,
              icon=str(ICON) if ICON.exists() else None)
    coll = COLLECT(exe, a.binaries, a.datas, name=NAME)
else:
    exe = EXE(pyz, a.scripts, a.binaries, a.datas, [], name=NAME, console=False,
              icon=str(ICON) if ICON.exists() else None, upx=False)

if sys.platform == "darwin":
    app = BUNDLE(exe if not ONEDIR else coll, name=("HGRTool.app" if LANG == "en" else f"HGRTool-{LANG}.app"),
                 icon=str(ICON) if ICON.exists() else None,
                 bundle_identifier="com.hgrtool.desktop")
